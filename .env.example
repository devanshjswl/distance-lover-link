# Copy this file to .env.local for local dev, and set the same keys in your
# Vercel project (Project Settings → Environment Variables) for production.
#
# These are the Firebase Web *client* config values — they identify your
# Firebase project to the browser SDK and are safe to ship in a public
# bundle (this is how every Firebase web app works). They are NOT secrets:
# access control is enforced by Firestore/Storage Security Rules
# (see firestore.rules / storage.rules), not by hiding these values.
#
# Get them from: Firebase Console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.
#
# Never put a service-account JSON key or any server-side Admin SDK
# credential in a VITE_ variable — those are private and must never ship
# to the browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed if you enable Web Push notifications
# (Firebase Console → Project settings → Cloud Messaging → Web Push
# certificates → generate a key pair).
VITE_FIREBASE_VAPID_KEY=
